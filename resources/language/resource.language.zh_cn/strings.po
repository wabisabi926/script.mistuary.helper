msgctxt "#32001"
msgid "Server ID"
msgstr "服务器 ID"

msgctxt "#32002"
msgid "Results per page"
msgstr "每页条数"

msgctxt "#32003"
msgid "Cache lifetime (seconds)"
msgstr "缓存时长（秒）"

msgctxt "#32004"
msgid "Fetch Douban rating"
msgstr "获取豆瓣评分"

msgctxt "#32005"
msgid "Debug logging"
msgstr "写调试日志"

msgctxt "#32011"
msgid "Clear cache"
msgstr "清空缓存"

msgctxt "#32020"
msgid "Open this add-on from the skin's search page."
msgstr "请从皮肤搜索进入本插件。"

msgctxt "#32021"
msgid "No Emby server found. Sign in to the Emby add-on first."
msgstr "没有找到 Emby 服务器，请先登录 Emby 插件。"

msgctxt "#32022"
msgid "Type something to search."
msgstr "请输入搜索词。"

msgctxt "#32023"
msgid "Emby login expired. Reconnect the Emby add-on."
msgstr "Emby 登录已失效，请重新连接 Emby 插件。"

msgctxt "#32024"
msgid "Cannot reach the Emby server. Check the network or address."
msgstr "无法连接 Emby 服务器，请检查网络或地址。"

msgctxt "#32025"
msgid "Emby returned an error (HTTP {0})."
msgstr "Emby 返回错误（HTTP {0}）。"

msgctxt "#32026"
msgid "No results for “{0}”."
msgstr "没有找到“{0}”。"

msgctxt "#32027"
msgid "Load more…"
msgstr "加载更多…"

msgctxt "#32028"
msgid "Cache cleared."
msgstr "缓存已清空。"

msgctxt "#32032"
msgid "Prefer Emby Douban rating"
msgstr "优先读 Emby 豆瓣分"

msgctxt "#32036"
msgid "Server URL override"
msgstr "地址覆盖"

msgctxt "#32037"
msgid "API key override"
msgstr "API Key 覆盖"

msgctxt "#32040"
msgid "Emby server"
msgstr "Emby 服务器"

msgctxt "#32041"
msgid "Search"
msgstr "搜索"

msgctxt "#32042"
msgid "Douban rating"
msgstr "豆瓣评分"

msgctxt "#32043"
msgid "Playback"
msgstr "播放列表"

msgctxt "#32044"
msgid "Logging & diagnostics"
msgstr "日志与诊断"

msgctxt "#32045"
msgid "Test Emby connection"
msgstr "测试 Emby 连接"

msgctxt "#32047"
msgid "Connected: {0}"
msgstr "连接成功：{0}"

msgctxt "#32048"
msgid "Connection failed: {0}"
msgstr "连接失败：{0}"

msgctxt "#32050"
msgid "Leave empty to use the default server; set only when multiple servers exist."
msgstr "留空使用默认服务器；仅多服务器时填写。"

msgctxt "#32051"
msgid "Leave empty to follow Emby for Kodi Next Gen; set only to rate against another server."
msgstr "留空跟随 Emby for Kodi Next Gen；仅评分需查询其他服务器时填写地址。"

msgctxt "#32052"
msgid "The address and API key must both be set; rating lookups only, search still uses the Emby add-on."
msgstr "地址与 API Key 需同时填写才生效；仅影响评分查询，搜索仍走 Emby 插件。"

msgctxt "#32053"
msgid "Tests the address and API key above; the result appears as a notification."
msgstr "测试上方地址与 API Key，结果显示为通知。"

msgctxt "#32054"
msgid "Results per page, default 100."
msgstr "每页搜索结果数量，默认 100。"

msgctxt "#32055"
msgid "Search cache lifetime, default 300 seconds."
msgstr "搜索结果缓存时间，默认 300 秒。"

msgctxt "#32056"
msgid "Show the Douban rating on the info page; no Douban requests when off."
msgstr "在详情页显示豆瓣分；关闭后不再请求豆瓣。"

msgctxt "#32057"
msgid "Prefer StrmAssistant ratings; when off, query the public API directly."
msgstr "优先使用 StrmAssistant 的评分；关闭后直接查询公开接口。"

msgctxt "#32058"
msgid "Write MISTUARY.HELPER logs to kodi.log for troubleshooting."
msgstr "将 MISTUARY.HELPER 日志写入 kodi.log，用于排查问题。"

msgctxt "#32059"
msgid "Delete search and rating caches; settings are kept."
msgstr "删除搜索与评分缓存，不影响设置。"

msgctxt "#32060"
msgid "Playlist completion"
msgstr "播放列表补全"

msgctxt "#32061"
msgid "Append the rest of the season when a library episode starts; playback is not interrupted."
msgstr "剧集起播时，将本季其余剧集加入队列；不打断当前播放。"

msgctxt "#32063"
msgid "Library episodes: rest of season"
msgstr "媒体库剧集：按季补全"

msgctxt "#32064"
msgid "Folder playback: rest of folder"
msgstr "文件夹播放：按目录补全"

msgctxt "#32065"
msgid "Append the rest of the folder when playback starts from a folder; playback is not interrupted."
msgstr "视频或音乐从文件夹起播时，将同目录其余条目加入队列；不打断当前播放。"

msgctxt "#32066"
msgid "Fall back to the public API when no rating"
msgstr "无豆瓣分时回退公开接口"

msgctxt "#32067"
msgid "Fetch from the public API when StrmAssistant has no rating. One extra request on first view."
msgstr "StrmAssistant 有条目但无评分时改查公开接口；首次显示多一次请求。"

msgctxt "#32068"
msgid "Episodes: continue to next season"
msgstr "剧集：跨季继续"

msgctxt "#32069"
msgid "When the last episode of a season starts, queue the first episode of the next season. Works with 'rest of season'."
msgstr "本季最后一集起播时，把下一季第一集加入队列；配合“按季补全”使用。"
