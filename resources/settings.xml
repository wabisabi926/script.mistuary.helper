<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
    <section id="script.mistuary.helper">
        <category id="server" label="32040" help="">
            <group id="1" label="32040">
                <setting id="server_id" type="string" label="32001" help="32050">
                    <level>3</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string"/>
                </setting>
                <setting id="emby_url_override" type="string" label="32036" help="32051">
                    <level>3</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string"/>
                </setting>
                <setting id="emby_token_override" type="string" label="32037" help="32052">
                    <level>3</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <hidden>true</hidden>
                    </control>
                </setting>
                <setting id="test_connection" type="action" label="32045" help="32053">
                    <level>0</level>
                    <data>RunPlugin(plugin://script.mistuary.helper/?action=test_connection)</data>
                    <control type="button" format="action"/>
                </setting>
                <setting id="library_icons_sync" type="action" label="32150" help="32151">
                    <level>0</level>
                    <data>RunPlugin(plugin://script.mistuary.helper/?action=library_icons_sync)</data>
                    <control type="button" format="action"/>
                </setting>
            </group>
        </category>

        <category id="search" label="32041" help="">
            <group id="1" label="32041">
                <setting id="page_size" type="integer" label="32002" help="32054">
                    <level>3</level>
                    <default>100</default>
                    <constraints>
                        <minimum>10</minimum>
                        <maximum>500</maximum>
                        <step>10</step>
                    </constraints>
                    <control type="edit" format="integer"/>
                </setting>
                <setting id="cache_ttl" type="integer" label="32003" help="32055">
                    <level>3</level>
                    <default>300</default>
                    <constraints>
                        <minimum>0</minimum>
                        <maximum>3600</maximum>
                        <step>30</step>
                    </constraints>
                    <control type="edit" format="integer"/>
                </setting>
            </group>
        </category>

        <category id="playback" label="32043" help="">
            <group id="1" label="32060">
                <setting id="playlist_completion_season" type="boolean" label="32063" help="32061">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="playlist_completion_next_season" type="boolean" label="32068" help="32069">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="playlist_completion_folder" type="boolean" label="32064" help="32065">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
            <group id="2" label="32076">
                <setting id="file_resume" type="boolean" label="32070" help="32071">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="file_resume_ttl_days" type="string" label="32083" help="32084">
                    <level>0</level>
                    <default>90</default>
                    <control type="spinner" format="string"/>
                    <constraints>
                        <options>
                            <option label="32085">30</option>
                            <option label="32086">90</option>
                            <option label="32087">180</option>
                            <option label="32088">365</option>
                            <option label="32089">0</option>
                        </options>
                    </constraints>
                </setting>
                <setting id="file_resume_max_records" type="string" label="32090" help="32091">
                    <level>0</level>
                    <default>5000</default>
                    <control type="spinner" format="string"/>
                    <constraints>
                        <options>
                            <option label="32102">1000</option>
                            <option label="32103">3000</option>
                            <option label="32104">5000</option>
                            <option label="32105">10000</option>
                        </options>
                    </constraints>
                </setting>
                <setting id="file_resume_http" type="boolean" label="32106" help="32107">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
            </group>
            <group id="3" label="32108">
                <setting id="file_resume_status" type="action" label="32098" help="32099">
                    <level>0</level>
                    <data>RunScript(script.mistuary.helper,action=file_resume_status)</data>
                    <control type="button" format="action"/>
                </setting>
                <setting id="file_resume_clean_now" type="action" label="32092" help="32093">
                    <level>0</level>
                    <data>RunScript(script.mistuary.helper,action=file_resume_clean)</data>
                    <control type="button" format="action"/>
                </setting>
                <setting id="file_resume_clear_all" type="action" label="32094" help="32095">
                    <level>0</level>
                    <data>RunScript(script.mistuary.helper,action=file_resume_clear)</data>
                    <control type="button" format="action"/>
                </setting>
            </group>
        </category>

        <category id="douban" label="32042" help="">
            <group id="1" label="32042">
                <setting id="douban_enabled" type="boolean" label="32004" help="32056">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="douban_prefer_emby" type="boolean" label="32032" help="32057">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="douban_fallback_public" type="boolean" label="32066" help="32067">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>

        <category id="logs" label="32044" help="">
            <group id="1" label="32044">
                <setting id="debug_log" type="boolean" label="32005" help="32058">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="clear_cache" type="action" label="32011" help="32059">
                    <level>0</level>
                    <data>RunPlugin(plugin://script.mistuary.helper/?action=clear_cache)</data>
                    <control type="button" format="action"/>
                </setting>
            </group>
        </category>
    </section>
</settings>
