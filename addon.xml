<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.mistuary.helper"
       name="Mistuary Helper"
       version="0.3.5"
       provider-name="wabisabi926">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <!-- provides=video：搜索结果要作为视频目录被 Kodi 识别。
             没有它，plugin:// 路径仍能打开，但 content type 未知，
             皮肤容器的 Content(movies) 判断会失效。 -->
        <provides>video</provides>
    </extension>
    <!-- 同时声明 script：皮肤的 RunScript(action=rating) 走脚本模式，
         否则 Kodi 会警告 "RunScript called for a non-script addon"。 -->
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <!-- 事件驱动的小服务：只做播放列表补全，设置默认关（关=立即返回）。
         0.3.3 删除的是评分同步的常驻服务；这个服务不轮询、不写库。 -->
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_gb">Server-side search and Douban rating bridge for the Mistuary skin</summary>
        <summary lang="zh_cn">Mistuary 皮肤的服务端搜索与豆瓣评分桥</summary>
        <description lang="en_gb">Optional add-on. Search uses the Emby server, so Chinese titles, original titles, full pinyin and initials work like in the Emby app. Douban ratings are read from the StrmAssistant Emby plugin first, falling back to the public Douban API.</description>
        <description lang="zh_cn">可选插件。搜索走 Emby 服务端，支持中文标题、原名、全拼和首字母；详情页豆瓣评分优先从 StrmAssistant 插件读取，失败再回退豆瓣公开接口。</description>
        <disclaimer lang="zh_cn">只在本地读取 Emby 插件的服务器配置，令牌不会写入日志或缓存。</disclaimer>
        <language></language>
        <platform>all</platform>
        <license>GPL-3.0-only</license>
        <forum></forum>
        <website></website>
        <source></source>
        <!-- 图标 / 背景由 tools/gen_assets.py 生成到 resources/。
             <assets> 必须放在 xbmc.addon.metadata 这个 extension 内部 ——
             放到 extension 外面 Kodi 不解析，只能靠 addon 根目录的同名
             icon.png / fanart.jpg 兜底，一旦根目录没有就全空。 -->
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
